# Copie para .env e ajuste conforme o ambiente

PORT=2567
INSTANCE_ID=local

# Redis: coordena presenca + matchmaking entre multiplas instancias.
# Obrigatorio em producao com mais de 1 instancia. Opcional rodando so localmente.
USE_REDIS=true
REDIS_URL=redis://localhost:6379

# Postgres: historico de partidas hoje; contas de jogador no futuro.
DATABASE_URL=postgres://squad_tactics:squad_tactics_dev_password@localhost:5432/squad_tactics
